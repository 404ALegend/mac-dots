#!/bin/sh
set -eu

# Chezmoi reruns this script only after its contents change.
# Yazi package manifest: {{ include "dot_config/yazi/package.toml" | sha256sum }}

mkdir -p "$HOME/Developer/dataset-exports"

if ! command -v mise >/dev/null 2>&1; then
  printf '%s\n' 'Skipping OMP plugins. Install Mise, then run chezmoi apply again.' >&2
  exit 0
fi

mise install oh-my-pi yazi zoxide npm:@yaakapp/cli
mise reshim
mise exec yazi -- ya pkg install
find "$HOME/Developer" -mindepth 1 -maxdepth 1 -type d \
  -exec mise exec zoxide -- zoxide add {} +
mise exec oh-my-pi -- omp plugin install \
  npm:@plannotator/pi-extension \
  agent-simple-english
mise exec npm:@yaakapp/cli -- yaak agent install

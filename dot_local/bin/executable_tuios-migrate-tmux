#!/usr/bin/env bash
# Recreate current tmux session topology in TUIOS with fresh shells.
set -euo pipefail

apply=false
replace=false
tmux_server=""
tuios_server=""
separator=$'\034'


die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: tuios-migrate-tmux [--dry-run|--apply] [--replace] [--tmux-server NAME] [--tuios-server NAME]

Recreate each current tmux session as a detached TUIOS session. Every tmux
window becomes a TUIOS workspace, and every tmux pane becomes a fresh shell in
its current directory.

No live process, scrollback, terminal state, agent conversation, or pane layout
is transferred. TUIOS scrolling layout shows panes as full-width columns.

Options:
  --dry-run             Print the migration plan without changing TUIOS (default).
  --apply               Create the TUIOS sessions.
  --replace             With --apply, replace same-named TUIOS sessions.
  --tmux-server NAME    Read an isolated tmux server started with tmux -L NAME.
  --tuios-server NAME   Write an isolated TUIOS daemon named NAME.
  -h, --help            Show this help.
EOF
}

while (( $# )); do
  case "$1" in
    --dry-run) apply=false ;;
    --apply) apply=true ;;
    --replace) replace=true ;;
    --tmux-server)
      (( $# >= 2 )) || die '--tmux-server needs a name'
      tmux_server="$2"
      shift
      ;;
    --tuios-server)
      (( $# >= 2 )) || die '--tuios-server needs a name'
      tuios_server="$2"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *) die "unknown option: $1" ;;
  esac
  shift
done

$replace && ! $apply && die '--replace requires --apply'
command -v tmux >/dev/null 2>&1 || die 'tmux is not installed'
command -v tuios >/dev/null 2>&1 || die 'tuios is not installed'
command -v jq >/dev/null 2>&1 || die 'jq is not installed'

tmux_cmd=(tmux)
[[ -n "$tmux_server" ]] && tmux_cmd+=(-L "$tmux_server")

run_tuios() {
  # Do not make migrated shells think they are nested inside the tmux source.
  if [[ -n "$tuios_server" ]]; then
    env -u TMUX -u TMUX_PANE tuios "$@" --server "$tuios_server"
  else
    env -u TMUX -u TMUX_PANE tuios "$@"
  fi
}

tuios_session_exists() {
  run_tuios ls --json 2>/dev/null |
    jq -e --arg name "$1" '.[] | select(.name == $name)' >/dev/null
}

session_file="$(mktemp)"
trap 'rm -f "$session_file" "${pane_file:-}"' EXIT
"${tmux_cmd[@]}" list-sessions -F "#{session_id}${separator}#{session_name}" > "$session_file" ||
  die 'the selected tmux server has no sessions'

while IFS="$separator" read -r session_id session_name; do
  [[ -n "$session_id" ]] || continue

  pane_file="$(mktemp)"
  "${tmux_cmd[@]}" list-panes -s -t "$session_id" \
    -F "#{window_index}${separator}#{window_name}${separator}#{pane_index}${separator}#{pane_current_path}" > "$pane_file"
  [[ -s "$pane_file" ]] || die "tmux session $session_name has no panes"

  workspace_count="$(cut -d "$separator" -f1 "$pane_file" | uniq | wc -l | tr -d ' ')"
  (( workspace_count <= 9 )) || die "$session_name has $workspace_count windows; TUIOS supports at most 9 workspaces"

  first_cwd="$(head -n 1 "$pane_file" | cut -d "$separator" -f4-)"
  printf 'Session: %s (%s workspaces)\n' "$session_name" "$workspace_count"
  awk -F "$separator" '
    !seen[$1]++ { workspace += 1; printf "  workspace %d: %s\n", workspace, $2 }
    { printf "    shell: %s\n", $4 }
  ' "$pane_file"

  if $apply; then
    if tuios_session_exists "$session_name"; then
      if $replace; then
        run_tuios kill-session "$session_name"
      else
        die "TUIOS session already exists: $session_name (use --replace to recreate it)"
      fi
    fi

    run_tuios new "$session_name" --cwd "$first_cwd" --detach

    workspace=0
    previous_window=""
    first_pane=true
    while IFS="$separator" read -r tmux_window window_name pane_index pane_cwd; do
      if [[ "$tmux_window" != "$previous_window" ]]; then
        workspace=$((workspace + 1))
        previous_window="$tmux_window"
        run_tuios set-workspace-name "$workspace" "$window_name" --session "$session_name"
      fi

      pane_name="$window_name:$pane_index"
      if $first_pane; then
        run_tuios set-window --session "$session_name" --name "$pane_name"
        first_pane=false
      else
        run_tuios new-window "$pane_name" --session "$session_name" \
          --workspace "$workspace" --cwd "$pane_cwd" --no-focus
      fi
    done < "$pane_file"
  fi

  rm -f "$pane_file"
  unset pane_file
done < "$session_file"

if ! $apply; then
  printf '\nDry run only. Run tuios-migrate-tmux --apply to create these fresh-shell sessions.\n'
fi
